# kidspython-tutor MCP server — copy to .env and fill in real values.
# Never commit .env.
TUTOR_BASE_URL=http://127.0.0.1:8100
TUTOR_USER=demo
TUTOR_PASS=your-tutor-password
TUTOR_TIMEOUT_S=120
KB_PATH=/absolute/path/to/datasets/kidspython-kb/1.1.0/built/chunks.jsonl
KB_DATASET=kidspython-kb
KB_VERSION=1.1.0
STORE_PATH=./data/tutor_mcp.sqlite
LANGFUSE_PUBLIC_KEY=pk-lf-example
LANGFUSE_SECRET_KEY=sk-lf-example
LANGFUSE_HOST=https://us.cloud.langfuse.com
SERVER_NAME=kidspython-tutor-mcp
SERVER_VERSION=0.1.0

# Discord bridge (optional — mcp/discord_bridge.py + deploy/)
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CHANNEL_ID=123456789012345678
